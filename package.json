{
  "name": "freelancer-mcp-server",
  "version": "2.1.0",
  "description": "MCP server for Freelancer.com \u2014 search & bid on projects, read/send messages, manage profiles/skills, multiple accounts each pinned to its own proxy, with the auto-bid bot's credit ledger / health / dedup guard on bids and paced messaging.",
  "main": "dist/index.js",
  "mcpName": "io.github.godesigntech/freelancer-mcp-server",
  "type": "module",
  "bin": {
    "freelancer-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "prepublishOnly": "npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "freelancer",
    "claude",
    "bidding",
    "freelance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godesigntech/freelancer-mcp-server.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "axios": "^1.7.2",
    "zod": "^3.23.8",
    "https-proxy-agent": "^7.0.6",
    "socks-proxy-agent": "^8.0.5",
    "mongodb": "^6.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5"
  }
}
